<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <app.stylusnotes.PaintView
        android:id="@+id/paint"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <Button
                    android:id="@+id/gallery"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Gallery"
                    app:icon="@drawable/ic_back" />

                <Button
                    android:id="@+id/actions"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Actions"
                    app:icon="@drawable/ic_wrench" />

                <Button
                    android:id="@+id/adjust"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Adjustments"
                    app:icon="@drawable/ic_wand" />

                <Button
                    android:id="@+id/select"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:checkable="true"
                    android:contentDescription="Selection"
                    app:icon="@drawable/ic_select" />

                <Button
                    android:id="@+id/transform"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:checkable="true"
                    android:contentDescription="Transform"
                    app:icon="@drawable/ic_transform" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <Button
                    android:id="@+id/brush"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:checkable="true"
                    android:contentDescription="Paint"
                    app:icon="@drawable/ic_brush" />

                <Button
                    android:id="@+id/smudge"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:checkable="true"
                    android:contentDescription="Smudge"
                    app:icon="@drawable/ic_smudge" />

                <Button
                    android:id="@+id/erase"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:checkable="true"
                    android:contentDescription="Erase"
                    app:icon="@drawable/ic_eraser" />

                <Button
                    android:id="@+id/layers"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Layers"
                    app:icon="@drawable/ic_layers" />

                <app.stylusnotes.Swatch
                    android:id="@+id/color"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Colour" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/side"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:id="@+id/sizeBox"
                android:layout_width="48dp"
                android:layout_height="168dp"
                android:clipChildren="false" />

            <Button
                android:id="@+id/pick"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:contentDescription="Eyedropper"
                app:icon="@drawable/ic_eyedropper" />

            <FrameLayout
                android:id="@+id/opBox"
                android:layout_width="48dp"
                android:layout_height="168dp"
                android:clipChildren="false" />

            <Button
                android:id="@+id/undo"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:contentDescription="Undo"
                app:icon="@drawable/ic_undo" />

            <Button
                android:id="@+id/redo"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Redo"
                app:icon="@drawable/ic_redo" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
        android:id="@+id/ctx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ctxRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp" />
    </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>

    <TextView
        android:id="@+id/debug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:background="#CC000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
