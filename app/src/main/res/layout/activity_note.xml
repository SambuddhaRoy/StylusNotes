<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

    <app.stylusnotes.InkView
        android:id="@+id/ink"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="20dp">

                <Button
                    android:id="@+id/back"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Back"
                    app:icon="@drawable/ic_back" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="Rename"
                    android:ellipsize="end"
                    android:maxWidth="280dp"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <Button
                    android:id="@+id/undo"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Undo"
                    app:icon="@drawable/ic_undo" />

                <Button
                    android:id="@+id/redo"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Redo"
                    app:icon="@drawable/ic_redo" />

                <Button
                    android:id="@+id/ai"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="AI"
                    app:icon="@drawable/ic_ai" />

                <Button
                    android:id="@+id/layers"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Layers"
                    app:icon="@drawable/ic_layers" />

                <Button
                    android:id="@+id/more"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="More"
                    app:icon="@drawable/ic_more" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layersPanel"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="28dp">

        <LinearLayout
            android:id="@+id/layersBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
        android:id="@+id/selBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="104dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/selCopy"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Duplicate"
                app:icon="@drawable/ic_copy" />

            <Button
                android:id="@+id/selDelete"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Delete selection"
                app:icon="@drawable/ic_delete" />

            <Button
                android:id="@+id/selDone"
                style="?attr/materialIconButtonFilledStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Done"
                app:icon="@drawable/ic_check" />
        </LinearLayout>
    </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>

    <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
        android:id="@+id/dock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/pen"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:contentDescription="Pen"
                    app:icon="@drawable/ic_pen" />

                <Button
                    android:id="@+id/eraser"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:contentDescription="Eraser"
                    app:icon="@drawable/ic_eraser" />

                <Button
                    android:id="@+id/lasso"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:contentDescription="Lasso"
                    app:icon="@drawable/ic_lasso" />

                <Button
                    android:id="@+id/text"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:contentDescription="Text"
                    app:icon="@drawable/ic_text" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <Button
                android:id="@+id/insert"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Insert"
                app:icon="@drawable/ic_add" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/colorOutlineVariant" />

            <app.stylusnotes.Swatch
                android:id="@+id/color"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Colour" />

            <com.google.android.material.slider.Slider
                android:id="@+id/size"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:contentDescription="Size"
                android:stepSize="1"
                android:value="4"
                android:valueFrom="1"
                android:valueTo="32"
                app:labelBehavior="gone" />
        </LinearLayout>
    </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>

    <TextView
        android:id="@+id/debug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="#CC000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
